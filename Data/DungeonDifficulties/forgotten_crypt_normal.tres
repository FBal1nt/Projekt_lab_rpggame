[gd_resource type="Resource" script_class="DungeonDifficultyData" load_steps=2 format=3]

[ext_resource type="Script" path="res://Scripts/Data/DungeonDifficultyData.gd" id="1_script"]

[resource]
script = ExtResource("1_script")
dungeon_id = &"forgotten_crypt"
id = &"normal"
display_name = "Közepes"
description = "Kiegyensúlyozott spawnráta: az alap szörnyek mellett páncélozott és mélyebb szobákban elit ellenfelek is megjelennek."
spawn_rate_multiplier = 1.0
enemy_level_min = 2
enemy_level_max = 4
enemy_type_ids = PackedStringArray("slime", "bat", "skeleton", "skeleton_archer", "orc", "armored_skeleton", "armored_orc", "armored_axeman", "elite_orc", "greatsword_skeleton")
enemy_type_names = PackedStringArray("Nyálka", "Denevér", "Csontváz", "Csontváz Íjász", "Ork", "Páncélozott Csontváz", "Páncélozott Ork", "Páncélozott Fejszés", "Elit Ork", "Nagy Kardos Csontváz")
elite_spawn_chance = 0.15
encounter_count_multiplier = 1.0
sort_order = 1
