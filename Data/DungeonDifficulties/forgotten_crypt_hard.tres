[gd_resource type="Resource" script_class="DungeonDifficultyData" load_steps=2 format=3]

[ext_resource type="Script" path="res://Scripts/Data/DungeonDifficultyData.gd" id="1_script"]

[resource]
script = ExtResource("1_script")
dungeon_id = &"forgotten_crypt"
id = &"hard"
display_name = "Nehéz"
description = "Maximális nehézség: nincsenek alap (Tier 1) szörnyek — kizárólag páncélozott és elit szörnyek jelennek meg."
spawn_rate_multiplier = 1.45
enemy_level_min = 5
enemy_level_max = 7
enemy_type_ids = PackedStringArray("armored_skeleton", "armored_orc", "armored_axeman", "elite_orc", "greatsword_skeleton", "werewolf", "werebear")
enemy_type_names = PackedStringArray("Páncélozott Csontváz", "Páncélozott Ork", "Páncélozott Fejszés", "Elit Ork", "Nagy Kardos Csontváz", "Farkasember", "Medveember")
elite_spawn_chance = 0.45
encounter_count_multiplier = 1.35
sort_order = 2
