[gd_resource type="Resource" script_class="EnchantmentData" load_steps=2 format=3]

[ext_resource type="Script" path="res://Scripts/Data/EnchantmentData.gd" id="1"]

[resource]
script = ExtResource("1")
id = &"poison_ward"
display_name = "Méregsemlegesítő rúna"
description = "Méregellenállást ad, és a harcon kívüli regenerációval segíti a felépülést."
workshop_type = &"wizard"
option_category = &"resistance"
element = &"poison"
applicable_item_types = PackedStringArray("armor", "ring", "earring", "shield", "helmet", "boots", "gloves")
ingredient_item_ids = PackedStringArray("arcane_dust", "leather_strip")
ingredient_amounts = PackedInt32Array(2, 2)
gold_cost = 85
stat_modifiers = {"poison_resistance": 20.0, "out_of_combat_hp_regen": 1.0}
